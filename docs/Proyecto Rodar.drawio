        <mxCell id="fh-k1-c1" parent="fh-k1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;db/vehiculos.py&lt;br&gt;$geoNear · reserva atómica · transiciones&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="104" as="geometry" />
