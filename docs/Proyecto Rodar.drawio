        <mxCell id="fh-k1-c2" parent="fh-k1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;MongoDB · colección vehiculos&lt;br&gt;índice 2dsphere en ubicacion&lt;/span&gt;" vertex="1">
