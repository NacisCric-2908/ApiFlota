        <mxCell id="fh-k2-c0" parent="fh-k2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;routers/localidades.py&lt;br&gt;listar · verificar · detalle (GeoJSON)&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="38" as="geometry" />
