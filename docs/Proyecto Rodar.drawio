        </mxCell>
        <mxCell id="fh-e048" edge="1" parent="fh-mid" source="fh-r1" target="fh-xcrud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#444444;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fh-e049" edge="1" parent="fh-mid" source="fh-r3" target="fh-xcrud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#444444;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fh-e050" edge="1" parent="fh-mid" source="fh-r2" target="fh-xvz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#444444;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fh-nota" parent="fh-mid" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;gradientColor=#FFF2A1;shadow=1;size=20;" value="&lt;b&gt;Por qué hexagonal en el MID&lt;/b&gt;&lt;br&gt;Las reglas (radio, batería, puntaje, zonas, alertas) viven en el núcleo y no saben nada de HTTP, de MongoDB ni de otros servicios. Los puertos son interfaces; los adaptadores se enchufan. En las pruebas unitarias se cambian por simulados (zonas caídas → 503, vehículos con 20 % de batería, reloj a +3 h), que es lo que pide el enunciado." vertex="1">
          <mxGeometry height="150" width="250" x="24" y="980" as="geometry" />
        </mxCell>
        <mxCell id="fh-crud-titulo" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;API CRUD Flota: arquitectura en capas&lt;/b&gt;&lt;br&gt;Controller → Repository → Base de datos. Es un CRUD: no necesita más." vertex="1">
          <mxGeometry height="50" width="640" x="1430" y="24" as="geometry" />
        </mxCell>
        <mxCell id="fh-k1" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" value="Vehículos" vertex="1">
          <mxGeometry height="244" width="310" x="1430" y="90" as="geometry" />
        </mxCell>
        <mxCell id="fh-k1-c0" parent="fh-k1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;routers/vehiculos.py&lt;br&gt;GET · POST · PUT · PATCH estado · DELETE&lt;/span&gt;" vertex="1">
