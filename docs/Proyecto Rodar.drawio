        <mxCell id="fj-nota1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=4;" value="&lt;b&gt;De dónde sale este flujo&lt;/b&gt;&lt;br&gt;La fase 2 respeta el flujo que ya dibujaron Viajes y Cuentas (página «Cuentas y Viajes»: usuario inactivo, liquidación pendiente, saldo) y le agrega la parte de Flota (consultar y reservar el vehículo). Las reglas de cada paso están en el documento de requisitos del clúster." vertex="1">
          <mxGeometry height="150" width="330" x="1680" y="90" as="geometry" />
        </mxCell>
        <mxCell id="fj-nota2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;arcSize=4;" value="&lt;b&gt;Propuesto: validar el punto final&lt;/b&gt;&lt;br&gt;«Validar que el punto esté en Bogotá» (fase 3) no está en el enunciado. Flota rechaza con 400 una ubicación fuera de Bogotá al liberar el vehículo; si Viajes y zonas ya guardó el viaje como finalizado, quedaría inconsistente. Por eso se propone validar antes de guardar. Acordar con Viajes y zonas." vertex="1">
          <mxGeometry height="175" width="330" x="1680" y="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
