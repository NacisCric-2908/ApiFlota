        <mxCell id="fl-ext-clima" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;Open-Meteo&lt;br&gt;API de tercero&lt;/font&gt;" vertex="1">
