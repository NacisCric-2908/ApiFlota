        <mxCell id="fh-k2-c1" parent="fh-k2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;db/localidades.py&lt;br&gt;$geoIntersects · carga idempotente&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="104" as="geometry" />
        </mxCell>
        <mxCell id="fh-k2-c2" parent="fh-k2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;MongoDB · colección localidades&lt;br&gt;índice 2dsphere en geometria&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="170" as="geometry" />
        </mxCell>
        <mxCell id="fh-k3" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;" value="Entorno (APIs de terceros)" vertex="1">
          <mxGeometry height="244" width="310" x="1430" y="370" as="geometry" />
        </mxCell>
        <mxCell id="fh-k3-c0" parent="fh-k3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;routers/entorno.py&lt;br&gt;GET clima · GET dirección&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="38" as="geometry" />
        </mxCell>
        <mxCell id="fh-k3-c1" parent="fh-k3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;externos/&lt;br&gt;timeout 3 s · 2 reintentos · caché · 1 petición/s&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="104" as="geometry" />
        </mxCell>
        <mxCell id="fh-k3-c2" parent="fh-k3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;API externa&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Open-Meteo · Nominatim (OSM)&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="170" as="geometry" />
        </mxCell>
        <mxCell id="fh-k4" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" value="Transversal" vertex="1">
          <mxGeometry height="244" width="310" x="1770" y="370" as="geometry" />
        </mxCell>
        <mxCell id="fh-k4-c0" parent="fh-k4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;core/&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;configuración (variables de entorno)&lt;br&gt;errores con formato común · seguridad X-Gateway-Secret&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="38" as="geometry" />
        </mxCell>
        <mxCell id="fh-k4-c1" parent="fh-k4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;schemas/&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;validación con Pydantic: datos inválidos → 400&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="104" as="geometry" />
        </mxCell>
        <mxCell id="fh-k4-c2" parent="fh-k4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;ensambla la app y, al arrancar, prepara índices y semilla&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="282" x="14" y="170" as="geometry" />
        </mxCell>
        <mxCell id="fh-decision" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=3;" value="&lt;b&gt;Decisión de arquitectura&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Sistema:&lt;/b&gt; microservicios detrás de un API Gateway; cada servicio con su propia base de datos (Flota usa MongoDB; Cuentas y Viajes, PostgreSQL).&lt;br&gt;• &lt;b&gt;MID Flota:&lt;/b&gt; hexagonal, porque concentra reglas de negocio que dependen de otros servicios y hay que probarlas aisladas.&lt;br&gt;• &lt;b&gt;CRUD Flota:&lt;/b&gt; en capas, tal como está construido en este repositorio (la regla de transiciones de estado vive en el repositorio, junto a la operación atómica). Si el equipo prefiere hexagonal estricto también aquí, es un refactor acotado.&lt;br&gt;• El MID Flota aún no está implementado: esta página es su diseño." vertex="1">
          <mxGeometry height="175" width="650" x="1430" y="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fl-pg-bd" name="BD flota">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fb-titulo" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Base de datos de Flota&lt;/b&gt;&lt;br&gt;MongoDB 7 en desarrollo; Azure Cosmos DB for MongoDB (API 7.0, serverless) en la nube. Base &lt;b&gt;no relacional&lt;/b&gt;, orientada a documentos, una base por servicio: no hay llaves foráneas entre Flota, Cuentas y Viajes. Dos colecciones: &lt;b&gt;vehiculos&lt;/b&gt; y &lt;b&gt;localidades&lt;/b&gt;." vertex="1">
          <mxGeometry height="70" width="1240" x="0" y="0" as="geometry" />
        </mxCell>
        <mxCell id="fb-veh" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;spacingRight=0;fontSize=12;strokeColor=#666666;fillColor=#ffffff;" value="&lt;div style=&#x27;background:#d5e8d4;border-bottom:1px solid #888;padding:6px 10px;&#x27;&gt;&lt;b style=&#x27;font-size:15px&#x27;&gt;vehiculos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Inventario de scooters y bicicletas · 30 documentos semilla&lt;/span&gt;&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse;width:618px;font-size:11px;&#x27;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#d5e8d4;text-align:left;width:120px&quot;&gt;Campo&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#d5e8d4;text-align:left;width:120px&quot;&gt;Tipo&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#d5e8d4;text-align:left;width:auto&quot;&gt;Reglas&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;_id&lt;/code&gt; 🔑&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;string&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;Clave primaria · «veh-0001» · patrón [A-Za-z0-9_-]{1,40}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;tipo&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;string&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;i&gt;scooter&lt;/i&gt; o &lt;i&gt;bicicleta&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;bateriaPct&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;int&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;0 a 100&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;estado&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;string&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;i&gt;disponible&lt;/i&gt;, &lt;i&gt;en_viaje&lt;/i&gt; o &lt;i&gt;mantenimiento&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;ubicacion&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;GeoJSON Point&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{type:&quot;Point&quot;, coordinates:[lng, lat]} · debe estar dentro de Bogotá&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;localidad&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;objeto embebido&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{codigo, nombre, slug} · lo calcula el servicio al crear o mover&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;actualizadoEn&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;date (UTC)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;la fija el servicio en cada escritura&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="292" width="620" x="0" y="100" as="geometry" />
        </mxCell>
        <mxCell id="fb-loc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;spacingRight=0;fontSize=12;strokeColor=#666666;fillColor=#ffffff;" value="&lt;div style=&#x27;background:#e1d5e7;border-bottom:1px solid #888;padding:6px 10px;&#x27;&gt;&lt;b style=&#x27;font-size:15px&#x27;&gt;localidades&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Las 20 localidades de Bogotá D.C. · datos abiertos (CC BY 4.0)&lt;/span&gt;&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse;width:558px;font-size:11px;&#x27;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#e1d5e7;text-align:left;width:110px&quot;&gt;Campo&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#e1d5e7;text-align:left;width:150px&quot;&gt;Tipo&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#e1d5e7;text-align:left;width:auto&quot;&gt;Reglas&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;_id&lt;/code&gt; 🔑&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;string&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;Código oficial «01» a «20» (igual a &lt;code&gt;codigo&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;codigo&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;string&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;«17»&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;nombre&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;string&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;«La Candelaria»&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;slug&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;string&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;«la-candelaria» · para filtrar sin tildes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;areaM2&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;int&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;área en metros cuadrados&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;geometria&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;GeoJSON MultiPolygon&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;límite oficial, ~250 KB en total&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="262" width="560" x="800" y="100" as="geometry" />
        </mxCell>
        <mxCell id="fb-rel" edge="1" parent="1" source="fb-veh" target="fb-loc" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;startSize=14;endSize=14;fontSize=11;strokeColor=#444444;labelBackgroundColor=default;" value="N vehículos : 1 localidad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fb-rel-nota" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;" value="&lt;span style=&#x27;font-size:11px&#x27;&gt;&lt;code&gt;vehiculos.localidad.codigo&lt;/code&gt; → &lt;code&gt;localidades._id&lt;/code&gt;&lt;br&gt;Referencia lógica, sin llave foránea. La API recalcula la localidad en cada escritura.&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="625" y="290" as="geometry" />
        </mxCell>
        <mxCell id="fb-viajes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;viajes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Viajes y zonas · PostgreSQL&lt;br&gt;&lt;code&gt;vehiculo_id&lt;/code&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="250" x="-330" y="170" as="geometry" />
        </mxCell>
        <mxCell id="fb-xref" edge="1" parent="1" source="fb-viajes" target="fb-veh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=11;strokeColor=#6c8ebf;endArrow=ERmandOne;startArrow=ERmany;startSize=12;endSize=12;labelBackgroundColor=default;" value="vehiculo_id → _id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fb-xref-nota" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" value="&lt;span style=&#x27;font-size:11px&#x27;&gt;Referencia lógica &lt;b&gt;entre servicios&lt;/b&gt;: Flota no sabe de viajes y la base de Viajes no puede tener llave foránea hacia MongoDB. La consistencia la mantiene el MID de Viajes (reservar al iniciar y liberar al terminar).&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="-330" y="250" as="geometry" />
        </mxCell>
        <mxCell id="fb-idx-veh" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;spacingRight=0;fontSize=12;strokeColor=#666666;fillColor=#ffffff;" value="&lt;div style=&#x27;background:#d5e8d4;border-bottom:1px solid #888;padding:6px 10px;&#x27;&gt;&lt;b style=&#x27;font-size:15px&#x27;&gt;Índices de vehiculos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;se crean al arrancar (idempotente)&lt;/span&gt;&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse;width:618px;font-size:11px;&#x27;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#d5e8d4;text-align:left;width:170px&quot;&gt;Nombre&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#d5e8d4;text-align:left;width:190px&quot;&gt;Clave&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#d5e8d4;text-align:left;width:auto&quot;&gt;Para qué&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;_id_&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{_id: 1} · único&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;buscar, reservar y borrar por id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;ubicacion_2dsphere&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{ubicacion: &quot;2dsphere&quot;}&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;búsqueda por cercanía ($geoNear)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;estado_1&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{estado: 1}&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;filtro por estado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;localidad_slug_1&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{localidad.slug: 1}&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;filtro por localidad&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="176" width="620" x="0" y="430" as="geometry" />
        </mxCell>
        <mxCell id="fb-idx-loc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;spacingRight=0;fontSize=12;strokeColor=#666666;fillColor=#ffffff;" value="&lt;div style=&#x27;background:#e1d5e7;border-bottom:1px solid #888;padding:6px 10px;&#x27;&gt;&lt;b style=&#x27;font-size:15px&#x27;&gt;Índices de localidades&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;&lt;/span&gt;&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse;width:558px;font-size:11px;&#x27;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#e1d5e7;text-align:left;width:170px&quot;&gt;Nombre&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#e1d5e7;text-align:left;width:180px&quot;&gt;Clave&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#e1d5e7;text-align:left;width:auto&quot;&gt;Para qué&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;_id_&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{_id: 1} · único&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;buscar por código&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;geometria_2dsphere&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;{geometria: &quot;2dsphere&quot;}&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;¿en qué localidad está un punto? ($geoIntersects)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="118" width="560" x="800" y="400" as="geometry" />
        </mxCell>
        <mxCell id="fb-ejemplo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;arcSize=3;" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Documento de ejemplo (vehiculos)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-family:monospace;font-size:11px;&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;_id&quot;: &quot;veh-0002&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;tipo&quot;: &quot;bicicleta&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;bateriaPct&quot;: 78,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;estado&quot;: &quot;disponible&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;ubicacion&quot;: { &quot;type&quot;: &quot;Point&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;coordinates&quot;: [-74.07345, 4.7092] },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;localidad&quot;: { &quot;codigo&quot;: &quot;11&quot;, &quot;nombre&quot;: &quot;Suba&quot;, &quot;slug&quot;: &quot;suba&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;actualizadoEn&quot;: ISODate(&quot;2026-11-22T14:20:28.958Z&quot;)&lt;br&gt;}&lt;/span&gt;" vertex="1">
          <mxGeometry height="230" width="620" x="0" y="640" as="geometry" />
        </mxCell>
        <mxCell id="fb-est-titulo" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Transiciones válidas de estado&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Cualquier otra, incluido repetir el estado actual, responde 409. Se aplican en una sola operación condicional sobre el documento.&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="560" x="800" y="550" as="geometry" />
        </mxCell>
        <mxCell id="fb-s-d" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="disponible" vertex="1">
          <mxGeometry height="60" width="140" x="820" y="640" as="geometry" />
        </mxCell>
        <mxCell id="fb-s-e" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="en_viaje" vertex="1">
          <mxGeometry height="60" width="140" x="1200" y="640" as="geometry" />
        </mxCell>
        <mxCell id="fb-s-m" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="mantenimiento" vertex="1">
          <mxGeometry height="60" width="140" x="1010" y="790" as="geometry" />
        </mxCell>
        <mxCell id="fb-t1" edge="1" parent="1" source="fb-s-d" target="fb-s-e" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;endArrow=classic;endFill=1;labelBackgroundColor=default;startArrow=classic;startFill=1;" value="reservar / liberar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fb-t2" edge="1" parent="1" source="fb-s-d" target="fb-s-m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;endArrow=classic;endFill=1;labelBackgroundColor=default;startArrow=classic;startFill=1;" value="mantenimiento">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="820" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="fb-t3" edge="1" parent="1" source="fb-s-e" target="fb-s-m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#444444;endArrow=classic;endFill=1;labelBackgroundColor=default;" value="avería en viaje">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="820" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="fb-consultas" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;spacingRight=0;fontSize=12;strokeColor=#666666;fillColor=#ffffff;" value="&lt;div style=&#x27;background:#fff2cc;border-bottom:1px solid #888;padding:6px 10px;&#x27;&gt;&lt;b style=&#x27;font-size:15px&#x27;&gt;Consultas clave y el índice que usan&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;las que más importan para el rendimiento y la consistencia&lt;/span&gt;&lt;/div&gt;&lt;table style=&#x27;border-collapse:collapse;width:1358px;font-size:11px;&#x27;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#fff2cc;text-align:left;width:420px&quot;&gt;Operación (endpoint)&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#fff2cc;text-align:left;width:auto&quot;&gt;Consulta en MongoDB&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:4px 8px;background:#fff2cc;text-align:left;width:200px&quot;&gt;Índice&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;Vehículos cercanos, del más cercano al más lejano&lt;br&gt;&lt;code&gt;GET /vehiculos?lat&amp;lng&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;$geoNear&lt;/code&gt; con &lt;code&gt;$facet&lt;/code&gt; para paginar y contar&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;ubicacion_2dsphere&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;Reserva atómica: solo un viaje gana&lt;br&gt;&lt;code&gt;PATCH /vehiculos/{id}/estado&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;find_one_and_update({_id, estado ∈ orígenes permitidos})&lt;/code&gt;: una sola operación condicional&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;_id_&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;¿En qué localidad está un punto? (validar «dentro de Bogotá»)&lt;br&gt;&lt;code&gt;POST / PUT / PATCH&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;find_one({geometria: {$geoIntersects: punto}})&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;geometria_2dsphere&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;Eliminar solo si no está en viaje&lt;br&gt;&lt;code&gt;DELETE /vehiculos/{id}&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;delete_one({_id, estado: {$ne: «en_viaje»}})&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;_id_&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;Filtrar por estado o por localidad&lt;br&gt;&lt;code&gt;GET /vehiculos?estado&amp;localidad&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;find({estado, localidad.slug})&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;estado_1&lt;/code&gt;, &lt;code&gt;localidad_slug_1&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;Conteo de vehículos por localidad y estado&lt;br&gt;&lt;code&gt;GET /localidades&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;&lt;code&gt;$group&lt;/code&gt; por &lt;code&gt;localidad.codigo&lt;/code&gt; y &lt;code&gt;estado&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px 8px;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="290" width="1360" x="0" y="900" as="geometry" />
        </mxCell>
        <mxCell id="fb-nota" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=4;" value="&lt;b&gt;Por qué MongoDB para Flota&lt;/b&gt;&lt;br&gt;Las consultas dominantes son geoespaciales (cercanía y punto en polígono) y el documento de un vehículo es autocontenido: la localidad va &lt;i&gt;embebida&lt;/i&gt; y no en otra tabla, así listar vehículos no necesita uniones. &lt;b&gt;Pendiente:&lt;/b&gt; probar estas consultas contra Cosmos DB antes de la demostración." vertex="1">
          <mxGeometry height="62" width="1360" x="0" y="1215" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
