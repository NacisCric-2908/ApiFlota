{
  "openapi": "3.1.0",
  "info": {
    "title": "API Flota - CRUD de Vehiculos",
    "description": "Inventario de scooters y bicicletas del clúster Rodar (MongoDB, consultas geoespaciales).",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Estado del servicio",
        "operationId": "verificarSalud",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Verificarsalud"
                }
              }
            }
          }
        }
      }
    },
    "/vehiculos/{vehiculo_id}": {
      "get": {
        "tags": [
          "Vehiculos"
        ],
        "summary": "Detalle de un vehículo",
        "operationId": "obtenerVehiculo",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:leer"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
