{
  "openapi": "3.1.0",
  "info": {
    "title": "API Flota - CRUD de Vehículos",
    "description": "Inventario de scooters y bicicletas del clúster Rodar (MongoDB, consultas geoespaciales).",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Estado del servicio",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/vehiculos/{vehiculo_id}": {
      "get": {
        "tags": [
          "Vehículos"
        ],
        "summary": "Detalle de un vehículo",
        "operationId": "detalle_vehiculos__vehiculo_id__get",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:leer"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiculoSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Vehículos"
        ],
        "summary": "Reemplazar un vehículo",
        "operationId": "reemplazar_vehiculos__vehiculo_id__put",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehiculoReemplazar"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiculoSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Vehículos"
        ],
        "summary": "Eliminar un vehículo (no permitido si está en viaje)",
        "operationId": "eliminar_vehiculos__vehiculo_id__delete",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "El vehículo está en viaje",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/vehiculos": {
      "post": {
        "tags": [
          "Vehículos"
        ],
        "summary": "Crear un vehículo",
        "operationId": "crear_vehiculos_post",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehiculoCrear"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiculoSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "El id ya existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Vehículos"
        ],
        "summary": "Listar vehículos con filtros, cercanía y paginación",
        "description": "Filtros: `tipo`, `estado`, `bateriaMin`. Cercanía: `lat` y `lng` van juntas; `radioMetros` (500 por defecto) solo se acepta con ellas. Con cercanía, el resultado va del más cercano al más lejano e incluye `distanciaMetros`.",
        "operationId": "listar_vehiculos_get",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:leer"
            ]
          }
        ],
        "parameters": [
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "scooter",
                    "bicicleta"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tipo"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "disponible",
                    "en_viaje",
                    "mantenimiento"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Estado"
            }
          },
          {
            "name": "bateriaMin",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Bateriamin"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90,
                  "minimum": -90
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lat"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180,
                  "minimum": -180
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lng"
            }
          },
          {
            "name": "radioMetros",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 50000,
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Radiometros"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Pagina"
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Tamano"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaVehiculos"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/vehiculos/{vehiculo_id}/estado": {
      "patch": {
        "tags": [
          "Vehículos"
        ],
        "summary": "Cambiar el estado (y opcionalmente ubicación y batería) de forma atómica",
        "description": "Transiciones válidas: `disponible`→`en_viaje`|`mantenimiento`, `en_viaje`→`disponible`|`mantenimiento`, `mantenimiento`→`disponible`. Repetir el estado actual responde 409. Si dos peticiones compiten por el mismo vehículo, solo una gana.",
        "operationId": "cambiar_estado_vehiculos__vehiculo_id__estado_patch",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambioEstado"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiculoSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de estado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CambioEstado": {
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "en_viaje",
              "mantenimiento"
            ],
            "title": "Estado"
          },
          "ubicacion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Punto"
              },
              {
                "type": "null"
              }
            ]
          },
          "bateriaPct": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0,
                "description": "Porcentaje de batería (0 a 100)."
              },
              {
                "type": "null"
              }
            ],
            "title": "Bateriapct"
          }
        },
        "type": "object",
        "required": [
          "estado"
        ],
        "title": "CambioEstado"
      },
      "ErrorRespuesta": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo"
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje"
          },
          "detalle": {
            "title": "Detalle",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "title": "ErrorRespuesta",
        "description": "Formato de error común a todos los servicios del clúster."
      },
      "PaginaVehiculos": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/VehiculoSalida"
            },
            "type": "array",
            "title": "Items"
          },
          "pagina": {
            "type": "integer",
            "title": "Pagina"
          },
          "tamano": {
            "type": "integer",
            "title": "Tamano"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "pagina",
          "tamano",
          "total"
        ],
        "title": "PaginaVehiculos"
      },
      "Punto": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Point",
            "title": "Type",
            "default": "Point"
          },
          "coordinates": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Coordinates"
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "Punto",
        "description": "Punto GeoJSON. Ojo: el orden de las coordenadas es [longitud, latitud]."
      },
      "VehiculoCrear": {
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "scooter",
              "bicicleta"
            ],
            "title": "Tipo"
          },
          "bateriaPct": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Bateriapct",
            "description": "Porcentaje de batería (0 a 100)."
          },
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "en_viaje",
              "mantenimiento"
            ],
            "title": "Estado"
          },
          "ubicacion": {
            "$ref": "#/components/schemas/Punto"
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id",
            "description": "Opcional. Si se omite, el servicio genera uno (veh-XXXXXXXX)."
          }
        },
        "type": "object",
        "required": [
          "tipo",
          "bateriaPct",
          "estado",
          "ubicacion"
        ],
        "title": "VehiculoCrear"
      },
      "VehiculoReemplazar": {
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "scooter",
              "bicicleta"
            ],
            "title": "Tipo"
          },
          "bateriaPct": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Bateriapct",
            "description": "Porcentaje de batería (0 a 100)."
          },
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "en_viaje",
              "mantenimiento"
            ],
            "title": "Estado"
          },
          "ubicacion": {
            "$ref": "#/components/schemas/Punto"
          }
        },
        "type": "object",
        "required": [
          "tipo",
          "bateriaPct",
          "estado",
          "ubicacion"
        ],
        "title": "VehiculoReemplazar"
      },
      "VehiculoSalida": {
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "scooter",
              "bicicleta"
            ],
            "title": "Tipo"
          },
          "bateriaPct": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Bateriapct",
            "description": "Porcentaje de batería (0 a 100)."
          },
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "en_viaje",
              "mantenimiento"
            ],
            "title": "Estado"
          },
          "ubicacion": {
            "$ref": "#/components/schemas/Punto"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "actualizadoEn": {
            "type": "string",
            "format": "date-time",
            "title": "Actualizadoen"
          },
          "distanciaMetros": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distanciametros",
            "description": "Solo aparece en búsquedas por cercanía."
          }
        },
        "type": "object",
        "required": [
          "tipo",
          "bateriaPct",
          "estado",
          "ubicacion",
          "id",
          "actualizadoEn"
        ],
        "title": "VehiculoSalida"
      }
    },
    "securitySchemes": {
      "GatewaySecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Gateway-Secret"
      },
      "OAuth2Gateway": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "scopes": {
              "vehiculos:leer": "Consultar vehículos",
              "vehiculos:escribir": "Crear, modificar, cambiar el estado y eliminar vehículos"
            },
            "tokenUrl": "/token"
          }
        }
      }
    }
  }
}
