    "/vehiculos/{vehiculo_id}/clima": {
      "get": {
        "tags": [
          "Entorno"
        ],
        "summary": "Clima actual en la ubicación del vehículo (Open-Meteo)",
        "description": "Consulta Open-Meteo con tiempo máximo de 3 s y hasta 2 reintentos; guarda el resultado 10 min. **Plan de degradación:** si Open-Meteo no responde se devuelve el último dato guardado (hasta 3 h) con `origen: cache_desactualizada`; si no hay ninguno, 503 `servicio_externo_no_disponible`.",
        "operationId": "obtenerClimaVehiculo",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:leer"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClimaSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "503": {
            "description": "Open-Meteo no responde y no hay dato guardado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/vehiculos/{vehiculo_id}/direccion": {
      "get": {
        "tags": [
          "Entorno"
        ],
        "summary": "Dirección de la ubicación del vehículo (Nominatim / OpenStreetMap)",
        "description": "Geocodificación inversa con tiempo máximo de 3 s, hasta 2 reintentos y no más de 1 petición por segundo (política de Nominatim); guarda el resultado 24 h. **Plan de degradación:** si Nominatim falla se devuelve el último dato guardado (hasta 7 días, `origen: cache_desactualizada`) y, si no hay, la localidad del vehículo calculada con datos propios (`origen: local`, solo `direccion` y `fuente`). Solo da 503 si el vehículo tampoco tiene localidad.",
        "operationId": "obtenerDireccionVehiculo",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:leer"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DireccionSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "503": {
            "description": "Nominatim no responde y no hay plan alterno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    }
