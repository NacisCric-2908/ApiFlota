    "/vehiculos": {
      "post": {
        "tags": [
          "Vehiculos"
        ],
        "summary": "Crear un vehículo",
        "operationId": "crearVehiculo",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehiculoCrear"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiculoSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "El id ya existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Vehiculos"
        ],
        "summary": "Listar vehículos con filtros, cercanía y paginación",
        "description": "Filtros: `tipo`, `estado`, `localidad`, `bateriaMin`. Cercanía: `lat` y `lng` van juntas; `radioMetros` (500 por defecto) solo se acepta con ellas. Con cercanía, el resultado va del más cercano al más lejano e incluye `distanciaMetros`.",
        "operationId": "listarVehiculos",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:leer"
            ]
          }
        ],
        "parameters": [
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "scooter",
                    "bicicleta"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tipo"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "disponible",
                    "en_viaje",
                    "mantenimiento"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Estado"
            }
          },
          {
            "name": "localidad",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Código ('17') o nombre ('La Candelaria', 'usaquen'). No distingue tildes ni mayúsculas.",
              "title": "Localidad"
            },
            "description": "Código ('17') o nombre ('La Candelaria', 'usaquen'). No distingue tildes ni mayúsculas."
          },
          {
            "name": "bateriaMin",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Bateriamin"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90,
                  "minimum": -90
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lat"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180,
                  "minimum": -180
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lng"
            }
          },
          {
            "name": "radioMetros",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 50000,
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Radiometros"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Pagina"
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Tamano"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaVehiculos"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/vehiculos/{vehiculo_id}/estado": {
      "patch": {
        "tags": [
          "Vehiculos"
        ],
        "summary": "Cambiar el estado (y opcionalmente ubicación y batería) de forma atómica",
        "description": "Transiciones válidas: `disponible`→`en_viaje`|`mantenimiento`, `en_viaje`→`disponible`|`mantenimiento`, `mantenimiento`→`disponible`. Repetir el estado actual responde 409. Si dos peticiones compiten por el mismo vehículo, solo una gana.",
        "operationId": "cambiarEstadoVehiculo",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambioEstado"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiculoSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de estado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
