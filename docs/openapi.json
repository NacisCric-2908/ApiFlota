        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
