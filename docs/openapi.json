              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehiculoReemplazar"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiculoSalida"
                }
              }
            }
          },
          "401": {
            "description": "Falta la cabecera secreta del gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Vehiculos"
        ],
        "summary": "Eliminar un vehículo (no permitido si está en viaje)",
        "operationId": "eliminarVehiculo",
        "security": [
          {
            "GatewaySecret": []
          },
          {
            "OAuth2Gateway": [
              "vehiculos:escribir"
            ]
          }
        ],
        "parameters": [
          {
            "name": "vehiculo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehiculo Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
