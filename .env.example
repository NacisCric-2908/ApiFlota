# Copiar a .env y ajustar. Docker Compose lo lee automáticamente.

# API
API_PORT=8000
LOG_LEVEL=info
# Secreto compartido con el API Gateway (cabecera X-Gateway-Secret). Cambiar en cada entorno.
GATEWAY_SECRET=cambiar-este-secreto

# MongoDB (en producción puede ser Cosmos DB con API de Mongo: solo cambia MONGO_URI)
MONGO_USER=flota
MONGO_PASSWORD=flota-dev-password
MONGO_DB=flota
# Si se define, reemplaza la URI construida por docker-compose
# MONGO_URI=mongodb://flota:flota-dev-password@mongo:27017/?authSource=admin

# APIs de terceros (gratuitas, sin llave). Los valores por defecto sirven; ver docs/terceros.md
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# EXTERNOS_USER_AGENT=ApiFlota-ClusterRodar/0.1
# EXTERNOS_TIMEOUT_S=3
# EXTERNOS_REINTENTOS=2
# EXTERNOS_BACKOFF_S=0.2
# NOMINATIM_INTERVALO_S=1.1

# Carga 30 vehículos semilla al arrancar con la colección vacía
SEED_ON_EMPTY=true
